      "extracted_sha256": "3143ea5c4e65a62df530abb5eb2c31348614ba0f622d0936690de8ba46dcacd6",
      "adaptation": "Add explicit curriculum identity, install corrected access paths, apply recorded access at each step, and guard immutable input paths. Preserve the historical model, initialization, BF16 gradient accumulation, FP32-master AdamW and evaluation. Restore the checkpoint training curve atomically before appending resumed measurements. Verify complete BF16 parameter and buffer initialization against the historical reference instead of platform-dependent FP32 common-parameter bytes."
    },
    {
      "source_repository": "residualized-sdm-routing",
      "source_commit": "aa5393d4939dd29965d062b45864355dcc635fa7",
      "source_path": "reproduction/train_recall.py",
